#!/usr/bin/env python3
"""Per-pod AirPods / Beats battery from Apple's BLE proximity-pairing adverts.

Prints a JSON array in the gadgets external format and exits:

    [{"id": "airpods:AA:BB:..", "name": "AirPods Pro", "kind": "earbuds",
      "pct": 80, "charging": false, "left": 80, "right": 90, "case": 50,
      "ts": 1750000000, "ttl": 180, "transport": "bluetooth"}]

Only scans when an Apple audio device is connected, and only for a few
seconds of LE discovery, so it costs nothing the rest of the time.

The advert is manufacturer data for company 0x004C whose first byte is 0x07
(proximity pairing). Nibble layout as decoded by AirStatus
(https://github.com/delphiki/AirStatus): pod levels 0-10 (x10 %), 15 = no
reading, and a flip bit that swaps left/right depending on which pod is
primary. The advert carries no address that ties it to the paired device
(it rotates), so it is matched by model instead: bytes 3-4 of the advert
(little-endian, 0e 20 -> 0x200E) must equal the product id in the connected
device's Modalias (bluetooth:v004Cp200E...), and the strongest such advert
above MIN_RSSI wins. Without a readable Modalias any Apple advert is taken,
but only from much closer (MIN_RSSI_UNMATCHED), so other people's AirPods
nearby are not reported as yours.

Each connected device is scanned for on its own adapter (the prefix of its
D-Bus path), so machines with several Bluetooth adapters work too.

LE discovery can cut audio on combined Wi-Fi/Bluetooth chips, so the last
reading is kept in ~/.cache/omarchy-gadget-batteries/airpods.json and the
radio is only scanned again after RESCAN_AFTER seconds, or right away while
the panel is open (GADGET_BATTERIES_PANEL_OPEN=1, set by Panel.qml). Entries
carry a TTL longer than that interval so they never go offline in between.
"""
import json
import os
import re
import sys
import time

SCAN_SECONDS = 6
MIN_RSSI = -65
MIN_RSSI_UNMATCHED = -55
RESCAN_AFTER = 300
TTL = 360
APPLE = 0x004C
CACHE = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"),
                     "omarchy-gadget-batteries", "airpods.json")
DEVICE = "org.bluez.Device1"


def out(entries):
    sys.stdout.write(json.dumps(entries) + "\n")
    sys.exit(0)


# Without python-dbus there is nothing to read; main() reports no gadgets.
# Exiting here instead would also end any test that imports this file.
try:
    import dbus
except ImportError:
    dbus = None


def is_apple_audio(props):
    modalias = str(props.get("Modalias", "")).lower()
    name = str(props.get("Name", props.get("Alias", "")))
    icon = str(props.get("Icon", ""))
    apple = ":v004c" in modalias or "airpods" in name.lower() or "beats" in name.lower()
    return bool(props.get("Connected", False)) and apple and icon.startswith("audio")


def level(nibble):
    return nibble * 10 if 0 <= nibble <= 10 else -1


def modalias_product(modalias):
    """Product id from an Apple Bluetooth Modalias, or None."""
    match = re.search(r"v004cp([0-9a-f]{4})", str(modalias or "").lower())
    return int(match.group(1), 16) if match else None


def advert_model(data):
    """Model id of a proximity-pairing advert: bytes 3-4, little-endian."""
    return data[3] | (data[4] << 8) if len(data) > 4 and data[0] == 0x07 else None


def adapter_of(path):
    """/org/bluez/hci0/dev_XX -> /org/bluez/hci0"""
    return str(path).rsplit("/", 1)[0]


def decode(data):
    if len(data) < 25 or data[0] != 0x07:
        return None
    raw = bytes(data).hex()
    flip = (int(raw[10], 16) & 0x02) == 0
    left = level(int(raw[12 if flip else 13], 16))
    right = level(int(raw[13 if flip else 12], 16))
    case = level(int(raw[15], 16))
    charging = int(raw[14], 16)
    return {
        "left": left,
        "right": right,
        "case": case,
        "leftCharging": (charging & (0b10 if flip else 0b01)) != 0,
        "rightCharging": (charging & (0b01 if flip else 0b10)) != 0,
        "caseCharging": (charging & 0b100) != 0,
    }


def best_reading(objects, path, props):
    """Strongest advert, seen by the same adapter, that belongs to the
    connected device at `path` with properties `props`."""
    adapter = adapter_of(path)
    expected = modalias_product(props.get("Modalias"))
    min_rssi = MIN_RSSI if expected is not None else MIN_RSSI_UNMATCHED
    best = None
    for object_path, ifs in objects.items():
        dev = ifs.get(DEVICE)
        if not dev or adapter_of(object_path) != adapter:
            continue
        data = dev.get("ManufacturerData", {}).get(APPLE)
        rssi = int(dev.get("RSSI", -999))
        if data is None or rssi < min_rssi:
            continue
        data = [int(b) for b in data]
        if expected is not None and advert_model(data) != expected:
            continue
        reading = decode(data)
        if reading and (best is None or rssi > best[0]):
            best = (rssi, reading)
    return best[1] if best else None


def entry(path, props, reading, now):
    pods = [v for v in (reading["left"], reading["right"]) if v >= 0]
    if not pods:
        return None
    return {
        "id": "airpods:" + str(props.get("Address", path)),
        "name": str(props.get("Alias", props.get("Name", "AirPods"))),
        "kind": "earbuds",
        "pct": min(pods),
        "charging": reading["leftCharging"] or reading["rightCharging"],
        "left": reading["left"],
        "right": reading["right"],
        "case": reading["case"],
        "ts": int(now),
        "ttl": TTL,
        "transport": "bluetooth",
    }


def entries_for(connected, objects, now):
    out_entries = []
    for path, props in connected:
        reading = best_reading(objects, path, props)
        result = entry(path, props, reading, now) if reading else None
        if result:
            out_entries.append(result)
    return out_entries


def cached_entries(connected, now, panel_open):
    """Last reading for these devices, or None when a new scan is due."""
    if panel_open:
        return None
    try:
        with open(CACHE) as handle:
            cache = json.load(handle)
    except (OSError, ValueError):
        return None
    ids = sorted("airpods:" + str(props.get("Address", path)) for path, props in connected)
    if cache.get("devices") != ids or now - float(cache.get("scannedAt", 0)) >= RESCAN_AFTER:
        return None
    return cache.get("entries", [])


def save_cache(connected, entries, now):
    ids = sorted("airpods:" + str(props.get("Address", path)) for path, props in connected)
    try:
        os.makedirs(os.path.dirname(CACHE), exist_ok=True)
        with open(CACHE + ".tmp", "w") as handle:
            json.dump({"scannedAt": now, "devices": ids, "entries": entries}, handle)
        os.replace(CACHE + ".tmp", CACHE)
    except OSError:
        pass


def scan(bus, adapter_path):
    adapter = dbus.Interface(bus.get_object("org.bluez", adapter_path), "org.bluez.Adapter1")
    started = False
    try:
        adapter.SetDiscoveryFilter({"Transport": "le", "DuplicateData": True})
        adapter.StartDiscovery()
        started = True
        time.sleep(SCAN_SECONDS)
    except dbus.DBusException:
        pass
    finally:
        if started:
            try:
                adapter.StopDiscovery()
            except dbus.DBusException:
                pass


def main():
    if dbus is None:
        out([])
    try:
        bus = dbus.SystemBus()
        manager = dbus.Interface(bus.get_object("org.bluez", "/"), "org.freedesktop.DBus.ObjectManager")
        objects = manager.GetManagedObjects()
    except dbus.DBusException:
        out([])

    connected = [(path, ifs[DEVICE]) for path, ifs in objects.items()
                 if DEVICE in ifs and is_apple_audio(ifs[DEVICE])]
    adapters = {path for path, ifs in objects.items() if "org.bluez.Adapter1" in ifs}
    scan_on = sorted({adapter_of(path) for path, _ in connected} & adapters)
    if not scan_on:
        out([])

    now = time.time()
    cached = cached_entries(connected, now, os.environ.get("GADGET_BATTERIES_PANEL_OPEN") == "1")
    if cached is not None:
        out(cached)

    for adapter_path in scan_on:
        scan(bus, adapter_path)
    try:
        objects = manager.GetManagedObjects()
    except dbus.DBusException:
        out([])
    entries = entries_for(connected, objects, now)
    save_cache(connected, entries, now)
    out(entries)


if __name__ == "__main__":
    main()
