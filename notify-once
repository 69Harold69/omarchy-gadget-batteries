#!/usr/bin/env python3
"""notify-once <key> <title> <body>: one low-battery notification per gadget,
however many bars (one per monitor) ask for it within WINDOW seconds."""
import fcntl
import json
import os
import subprocess
import sys
import time

WINDOW = 600
CACHE = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"), "omarchy-gadget-batteries")
STATE = os.path.join(CACHE, "notified.json")

if len(sys.argv) != 4:
    sys.exit(2)
key, title, body = sys.argv[1:]
os.makedirs(CACHE, exist_ok=True)
with open(os.path.join(CACHE, "notified.lock"), "w") as lock:
    fcntl.flock(lock, fcntl.LOCK_EX)
    try:
        with open(STATE) as handle:
            sent = json.load(handle)
    except (OSError, ValueError):
        sent = {}
    now = time.time()
    if now - float(sent.get(key, 0)) < WINDOW:
        sys.exit(0)
    sent = {k: v for k, v in sent.items() if now - float(v) < WINDOW}
    sent[key] = now
    with open(STATE, "w") as handle:
        json.dump(sent, handle)
subprocess.run(["notify-send", "-u", "critical", "-a", "Gadget Batteries", title, body])
